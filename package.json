{
  "name": "@ottatto/llp",
  "version": "0.0.0",
  "private": true,
  "description": "LaTeX の PDF をブラウザで（ほぼほぼ）リアルタイムにプレビューする",
  "type": "module",
  "bin": {
    "llp": "dist/bin/llp.js"
  },
  "files": [
    "dist",
    "client",
    "shared"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test \"server/**/!(*.build).test.ts\"",
    "test:build": "node --test \"bin/**/*.build.test.ts\" \"server/**/*.build.test.ts\"",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepack": "npm run build && npm pkg delete scripts.prepare",
    "postpack": "npm pkg set scripts.prepare=husky",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "pdfjs-dist": "^6.5.438",
    "smol-toml": "^1.9.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,ts,mts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{css,html,json,md,yaml,yml}": "oxfmt --write"
  }
}
