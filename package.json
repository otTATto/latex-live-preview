{
  "name": "@ottatto/llp",
  "version": "0.0.0",
  "private": true,
  "description": "LaTeX の PDF をブラウザで（ほぼほぼ）リアルタイムにプレビューする",
  "type": "module",
  "bin": {
    "llp": "bin/llp.js"
  },
  "files": [
    "bin",
    "server",
    "shared",
    "client",
    "!**/*.test.ts"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test \"server/**/*.test.ts\"",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "pdfjs-dist": "^6.5.438",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,ts,mts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{css,html,json,md,yaml,yml}": "oxfmt --write"
  }
}
